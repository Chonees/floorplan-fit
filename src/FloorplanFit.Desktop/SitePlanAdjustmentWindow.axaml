<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="using:FloorplanFit.Desktop.ViewModels"
        xmlns:controls="using:FloorplanFit.Desktop.Controls"
        x:Class="FloorplanFit.Desktop.SitePlanAdjustmentWindow"
        x:DataType="viewModels:SitePlanAdjustmentViewModel">
  <UserControl.Styles>
    <Style Selector="Border.fit-option-card">
      <Setter Property="Background" Value="{DynamicResource SectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.20" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.20" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.fit-option-card.fit-option-applied">
      <Setter Property="Background" Value="{DynamicResource ToolActiveCheckedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="RenderTransform" Value="scale(1.012)" />
    </Style>

    <Style Selector="Button.sidebar-action">
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.sidebar-action.sidebar-action-active">
      <Setter Property="Background" Value="{DynamicResource ToolActiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,400"
        ColumnSpacing="16"
        Margin="16">
    <Border x:Name="PreviewShell"
            Grid.Column="0"
            Classes="panel-card"
            ClipToBounds="True">
      <Grid RowDefinitions="*,Auto">
        <controls:FloorPlanPreviewControl x:Name="PreviewControl"
                                          MinHeight="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ClipToBounds="True"
                                          IsFloorPlanMoveToolActive="{Binding IsFloorPlanMoveToolActive}"
                                          SitePlanGeometryPaths="{Binding SitePlanGeometryPaths}"
                                          SitePlanRenderPaths="{Binding SitePlanRenderPaths}"
                                          SitePlanTexts="{Binding SitePlanTexts}"
                                          GeometryPaths="{Binding FloorPlanGeometryPaths}"
                                          RoomLabels="{Binding RoomLabels}"
                                          OpeningLabels="{Binding OpeningLabels}"
                                          Dimensions="{Binding Dimensions}"
                                          ChangedNumberDimensionIds="{Binding ChangedNumberDimensionIds}"
                                          AreDimensionsVisible="{Binding ArePreviewDimensionsVisible}" />

        <Border Grid.Row="1"
                Height="238"
                Padding="12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrushMuted}"
                IsVisible="{Binding IsCommissionedAutoFit}">
          <Grid RowDefinitions="Auto,*"
                RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
              <TextBlock Text="{Binding CommissionedComparisonStatus}"
                         TextWrapping="Wrap" />
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="12">
                <TextBlock Text="FloorPlan · blanco" />
                <TextBlock Foreground="#B922D3EE"
                           Text="Electrical · cian" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10"
                  IsVisible="{Binding IsCommissionedComparisonAvailable}">
              <Grid RowDefinitions="Auto,*">
                <TextBlock FontWeight="SemiBold"
                           Text="Antes · FloorPlan + Electrical registrado (estructura WALL)" />
                <controls:RegistrationOverlayPreviewControl Grid.Row="1"
                    CanonicalGeometry="{Binding CommissionedBeforeFloorGeometry}"
                    ElectricalGeometry="{Binding CommissionedBeforeElectricalGeometry}" />
              </Grid>
              <Grid Grid.Column="1"
                    RowDefinitions="Auto,*">
                <TextBlock FontWeight="SemiBold"
                           Text="Después · FloorPlan ajustado = ArchitecturalBase de Electrical" />
                <controls:RegistrationOverlayPreviewControl Grid.Row="1"
                    CanonicalGeometry="{Binding CommissionedAfterFloorGeometry}"
                    ElectricalGeometry="{Binding CommissionedAfterElectricalGeometry}" />
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="AdjustmentSidebar"
            Grid.Column="1"
            Classes="panel-card"
            ClipToBounds="True">
      <ScrollViewer x:Name="AdjustmentSidebarScroller"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
        <Border Classes="metric-chip">
          <StackPanel Orientation="Horizontal"
                      Spacing="10">
            <Button Classes="sidebar-action"
                    Classes.sidebar-action-active="{Binding IsFloorPlanMoveToolActive}"
                    MinWidth="120"
                    Content="Mover plano"
                    Command="{Binding ToggleFloorPlanMoveToolCommand}"
                    ToolTip.Tip="Arrastrá el floor plan; el site plan queda fijo." />
            <TextBlock FontWeight="SemiBold"
                       Text="Cotas"
                       VerticalAlignment="Center" />
            <ToggleSwitch Classes="preview-switch"
                          IsChecked="{Binding ArePreviewDimensionsVisible}"
                          OnContent="Visibles"
                          OffContent="Ocultas"
                          ToolTip.Tip="Mostrá u ocultá visualmente todas las cotas del preview." />
          </StackPanel>
        </Border>

        <Border Classes="section-card">
          <StackPanel Spacing="6"
                      MinWidth="0">
            <TextBlock Classes="muted"
                       Text="{Binding PreviewSelectionLabel}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="muted"
                       Text="{Binding AutoFitCandidateSummary}"
                       IsVisible="{Binding !IsCommissionedAutoFit}"
                       TextWrapping="Wrap" />
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding AutoFitSuggestionStatus}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding AutoFitSuggestionSummary}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="muted"
                       Text="{Binding AutoFitSuggestionPlanDetails}"
                       IsVisible="{Binding !IsCommissionedAutoFit}"
                       TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding PlanSetExportAuditLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Classes="muted"
                             Text="{Binding}"
                             TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <StackPanel Spacing="8">
          <Button HorizontalAlignment="Stretch"
                  Content="Sugerir ajuste (AI)"
                  IsVisible="{Binding !IsCommissionedAutoFit}"
                  Command="{Binding SuggestAutoFitPlanCommand}"
                  ToolTip.Tip="AI ordena; el validador determinístico decide si el plan es válido." />
          <Button HorizontalAlignment="Stretch"
                  Content="Exportar DXF"
                  IsVisible="{Binding !IsCommissionedAutoFit}"
                  IsEnabled="{Binding CanExportAdjustedSitePlan}"
                  Click="ExportAdjustedSitePlanButton_OnClick"
                  ToolTip.Tip="Genera un DXF con el floor plan ajustado (recortes aplicados) y el site plan con sus capas, listo para CAD." />
          <Button HorizontalAlignment="Stretch"
                  Content="Confirmar y exportar"
                  AutomationProperties.Name="Confirmar ajuste automático y exportar"
                  IsVisible="{Binding IsCommissionedAutoFit}"
                  IsEnabled="{Binding CanExportAdjustedSitePlan}"
                  Click="ExportAdjustedSitePlanButton_OnClick"
                  ToolTip.Tip="Confirma la propuesta automática mostrada y exporta el ajuste." />
          <Button HorizontalAlignment="Stretch"
                  Content="Confirmar manuales + re-exportar"
                  IsVisible="{Binding !IsCommissionedAutoFit}"
                  IsEnabled="{Binding CanConfirmManualPlanSetProjections}"
                  Command="{Binding ConfirmManualPlanSetProjectionsAndReExportCommand}"
                  ToolTip.Tip="Confirma las proyecciones manuales del último paquete y re-exporta usando el mismo ajuste canónico." />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding AutoFitSuggestionOptions}"
                      IsVisible="{Binding !IsCommissionedAutoFit}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"
                            Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:AutoFitSuggestionOptionViewModel">
                <Border Classes="section-card fit-option-card"
                        Classes.fit-option-applied="{Binding IsApplied}"
                        HorizontalAlignment="Stretch"
                        MinHeight="144">
                  <Grid RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="8">
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Text="{Binding Title}"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1"
                               Classes="muted"
                               FontSize="12"
                               Text="{Binding Details}"
                               TextWrapping="Wrap" />
                    <Button Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            Content="{Binding ApplyLabel}"
                            Click="ApplyAutoFitOptionButton_OnClick" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
