<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="using:FloorplanFit.Desktop.ViewModels"
        xmlns:contracts="using:FloorplanFit.Contracts.FloorPlans"
        xmlns:controls="using:FloorplanFit.Desktop.Controls"
        x:Class="FloorplanFit.Desktop.ReviewFloorPlanWindow"
        x:DataType="viewModels:FloorPlanReviewViewModel"
        Width="1400"
        Height="900"
        Title="Floor Plan Review">
  <Grid RowDefinitions="Auto,Auto,*" Margin="20">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding Name}" />
      <TextBlock VerticalAlignment="Center" Text="{Binding Code}" />
      <TextBlock VerticalAlignment="Center" Text="{Binding Status}" />
      <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8"
                Margin="0,16,0,16">
      <Button Content="Accept Candidate"
              Click="AcceptButton_OnClick" />
      <Button Content="Reject Candidate"
              Click="RejectButton_OnClick" />
      <Button Content="Save Metadata"
              Click="SaveMetadataButton_OnClick" />
      <Button Content="Publish Curation"
              Click="PublishButton_OnClick" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="340,*,360" ColumnSpacing="16">
      <Border Padding="12"
              BorderBrush="LightGray"
              BorderThickness="1"
              CornerRadius="6">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="12">
          <TextBlock FontSize="18"
                     FontWeight="SemiBold"
                     Text="Wall Candidates" />
          <ListBox Grid.Row="1"
                   MinHeight="0"
                   ItemsSource="{Binding WallCandidates}"
                   SelectedItem="{Binding SelectedCandidate}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="contracts:WallCandidateDto">
                <Border Padding="8"
                        Margin="0,0,0,8"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="4">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding SourceEntityRef}" />
                    <TextBlock Text="{Binding SourceLayer}" />
                    <TextBlock Text="{Binding Status}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Padding="12"
              Background="White"
              BorderBrush="LightGray"
              BorderThickness="1"
              CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="8">
          <TextBlock FontSize="18"
                     Foreground="Black"
                     FontWeight="SemiBold"
                     Text="Preview" />
          <TextBlock Grid.Row="1"
                     Foreground="DimGray"
                     Text="{Binding PreviewSelectionLabel}" />
          <controls:FloorPlanPreviewControl Grid.Row="2"
                                            MinHeight="0"
                                            GeometryPathClicked="PreviewControl_OnGeometryPathClicked"
                                            GeometryPaths="{Binding GeometryPaths}"
                                            HighlightGeometryPathId="{Binding HighlightGeometryPathId}" />
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Padding="12"
              BorderBrush="LightGray"
              BorderThickness="1"
              CornerRadius="6">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,*"
              RowSpacing="12">
          <TextBlock FontSize="18"
                     FontWeight="SemiBold"
                     Text="Inspector" />

          <StackPanel Grid.Row="1"
                      Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="Candidate" />
            <TextBlock Text="{Binding SelectedCandidate.SourceEntityRef}" />
            <TextBlock Text="{Binding SelectedCandidate.SourceLayer}" />
            <TextBlock Text="{Binding SelectedCandidate.Status}" />
          </StackPanel>

          <TextBlock Grid.Row="2"
                     Text="Stable Wall Id" />
          <TextBox Grid.Row="3"
                   Text="{Binding PendingStableWallId}" />

          <Grid Grid.Row="4"
                RowDefinitions="Auto,*"
                RowSpacing="8"
                MinHeight="0">
            <TextBlock FontWeight="SemiBold" Text="Curated Walls" />
            <ListBox Grid.Row="1"
                     MinHeight="0"
                     ItemsSource="{Binding CuratedWalls}"
                     SelectedItem="{Binding SelectedCuratedWall}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="contracts:CuratedWallDto">
                  <Border Padding="8"
                          Margin="0,0,0,8"
                          BorderBrush="LightGray"
                          BorderThickness="1"
                          CornerRadius="4">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="{Binding StableWallId}" />
                      <TextBlock Text="{Binding WallRole}" />
                      <TextBlock Text="{Binding MobilityLevel}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <Separator Grid.Row="5" />

          <ScrollViewer Grid.Row="6"
                        MinHeight="0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
              <TextBlock Text="Role" />
              <ComboBox ItemsSource="{Binding WallRoleOptions}"
                        SelectedItem="{Binding EditableWallRole}" />

              <TextBlock Text="Mobility" />
              <ComboBox ItemsSource="{Binding MobilityOptions}"
                        SelectedItem="{Binding EditableMobilityLevel}" />

              <TextBlock Text="Protection" />
              <ComboBox ItemsSource="{Binding ProtectionOptions}"
                        SelectedItem="{Binding EditableProtectionLevel}" />

              <TextBlock Text="Thickness (mm)" />
              <TextBox Text="{Binding EditableThicknessMm}" />

              <TextBlock Text="Assembly" />
              <TextBox Text="{Binding EditableAssemblyCode}" />

              <TextBlock Text="Height (mm)" />
              <TextBox Text="{Binding EditableHeightMm}" />

              <CheckBox Content="Exterior"
                        IsChecked="{Binding EditableIsExterior}" />

              <CheckBox Content="Structural Hint"
                        IsChecked="{Binding EditableIsStructuralHint}" />

              <TextBlock Text="Notes" />
              <TextBox AcceptsReturn="True"
                       Height="120"
                       Text="{Binding EditableNotes}" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
