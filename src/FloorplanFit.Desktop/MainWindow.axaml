<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="using:FloorplanFit.Desktop.ViewModels"
        xmlns:contracts="using:FloorplanFit.Contracts.FloorPlans"
        xmlns:planSets="using:FloorplanFit.Contracts.PlanSets"
        xmlns:views="using:FloorplanFit.Desktop"
        x:Class="FloorplanFit.Desktop.MainWindow"
        x:DataType="viewModels:LibraryViewModel"
        RequestedThemeVariant="Dark"
        TransparencyLevelHint="AcrylicBlur, Mica, Blur"
        Width="1280"
        Height="800"
        Title="{Binding ShellTitle}">
  <Window.Resources>
    <views:PendingRegistrationActionVisibilityConverter x:Key="PendingRegistrationActionVisibility" />
  </Window.Resources>
  <Grid>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
          Margin="24"
          IsVisible="{Binding IsLibraryScreenVisible}">
      <TextBlock FontSize="24"
                 FontWeight="Bold"
                 Text="Floorplan Library" />

      <Grid Grid.Row="1"
            ColumnDefinitions="Auto,Auto,Auto,Auto,*"
            ColumnSpacing="12"
            Margin="0,16,0,16">
        <Button Name="ImportButton"
                Grid.Column="0"
                Content="Import DXF"
                Click="ImportButton_OnClick" />
        <Button Name="ImportElectricalSheetButton"
                Grid.Column="1"
                Content="Import Electrical"
                Click="ImportElectricalSheetButton_OnClick" />
        <Button Name="ImportRoofSheetButton"
                Grid.Column="2"
                Content="Import Roof"
                Click="ImportRoofSheetButton_OnClick" />
        <Button Name="ImportFacadeSheetButton"
                Grid.Column="3"
                Content="Import Facade"
                Click="ImportFacadeSheetButton_OnClick" />
        <TextBlock Grid.Column="4"
                   VerticalAlignment="Center"
                   Text="{Binding SelectedVersionLabel}" />
      </Grid>

      <TextBlock Grid.Row="2"
                 Classes="muted"
                 Margin="0,0,0,12"
                 TextWrapping="Wrap"
                 Text="{Binding StatusMessage}" />

      <Border Grid.Row="3"
              Classes="section-card"
              Padding="10"
              Margin="0,0,0,12">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold"
                     Text="{Binding SelectedPlanSetSheetsLabel}" />
          <ItemsControl ItemsSource="{Binding SelectedPlanSetSheets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="planSets:PlanSetSheetDto">
                <Border Classes="panel-card"
                        Padding="8"
                        Margin="0,0,0,6">
                  <Grid RowDefinitions="Auto,Auto"
                        RowSpacing="6">
                    <WrapPanel Orientation="Horizontal">
                      <TextBlock Margin="0,0,10,0"
                                 FontWeight="SemiBold"
                                 Text="{Binding SheetType}" />
                      <TextBlock Margin="0,0,10,0"
                                 MaxWidth="260"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding Name}" />
                      <TextBlock Margin="0,0,10,0"
                                 Classes="muted"
                                 Text="{Binding RegistrationStatus}" />
                      <TextBlock Margin="0,0,10,0"
                                 MaxWidth="170"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding RegistrationQualityLabel}"
                                 Classes="muted"
                                 Text="{Binding RegistrationMethod}" />
                      <TextBlock Margin="0,0,10,0"
                                 Classes="muted"
                                 Text="{Binding RegistrationConfidence, StringFormat='{}conf {0:0.##}'}" />
                      <TextBlock Margin="0,0,10,0"
                                 Classes="muted"
                                 Text="{Binding ProjectionStatus}" />
                      <TextBlock Margin="0,0,10,0"
                                 MaxWidth="170"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding ProjectionQualityLabel}"
                                 Classes="muted"
                                 Text="{Binding ProjectionMethod}" />
                      <TextBlock Classes="muted"
                                 Text="{Binding ProjectionConfidence, StringFormat='{}conf {0:0.##}'}" />
                    </WrapPanel>

                    <WrapPanel Grid.Row="1"
                               Orientation="Horizontal">
                      <Button Margin="0,0,8,0"
                              Padding="8,2"
                              Content="Register"
                              IsVisible="{Binding CanRegisterDependent}"
                              Click="RegisterDependentSheetButton_OnClick" />
                      <Button Margin="0,0,8,0"
                              Padding="8,2"
                              Classes="primary"
                              Content="Revisar y confirmar"
                              IsVisible="{Binding Converter={StaticResource PendingRegistrationActionVisibility}, ConverterParameter=Electrical}"
                              Click="ReviewSheetRegistrationButton_OnClick" />
                      <Button Margin="0,0,8,0"
                              Padding="8,2"
                              Content="Confirm"
                              IsVisible="{Binding Converter={StaticResource PendingRegistrationActionVisibility}, ConverterParameter=NonElectrical}"
                              Click="ConfirmSheetRegistrationButton_OnClick" />
                      <Button Margin="0,0,8,0"
                              Padding="8,2"
                              Content="Reject Reg"
                              IsVisible="{Binding CanRejectRegistration}"
                              Click="RejectSheetRegistrationButton_OnClick" />
                      <Button Margin="0,0,8,0"
                              Padding="8,2"
                              Content="Confirm Projection"
                              IsVisible="{Binding CanConfirmProjection}"
                              Click="ConfirmSheetProjectionButton_OnClick" />
                      <Button Margin="0,0,8,0"
                              Padding="8,2"
                              Content="To Electrical"
                              IsVisible="{Binding CanCorrectToElectrical}"
                              Click="CorrectSheetToElectricalButton_OnClick" />
                      <Button Margin="0,0,8,0"
                              Padding="8,2"
                              Content="To Roof"
                              IsVisible="{Binding CanCorrectToRoof}"
                              Click="CorrectSheetToRoofButton_OnClick" />
                      <Button Margin="0,0,8,0"
                              Padding="8,2"
                              Content="To Facade"
                              IsVisible="{Binding CanCorrectToFacade}"
                              Click="CorrectSheetToFacadeButton_OnClick" />
                      <Button Padding="8,2"
                              Content="×"
                              IsVisible="{Binding CanUnlink}"
                              Click="UnlinkDependentSheetButton_OnClick" />
                    </WrapPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="4"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="contracts:FloorPlanLibraryItemDto">
              <Border Classes="panel-card"
                      Padding="12"
                      Margin="0,0,0,10">
                <Expander IsExpanded="True">
                  <Expander.Header>
                    <Grid ColumnDefinitions="2*,2*,Auto,Auto">
                      <TextBlock Grid.Column="0"
                                 FontWeight="SemiBold"
                                 Text="{Binding Code}" />
                      <TextBlock Grid.Column="1"
                                 Margin="12,0,0,0"
                                 Text="{Binding Name}" />
                      <TextBlock Grid.Column="2"
                                 Margin="12,0,0,0"
                                 Text="{Binding VersionCount, StringFormat='{}{0} version(s)'}" />
                      <TextBlock Grid.Column="3"
                                 Margin="12,0,0,0"
                                 Text="{Binding ActiveVersionNumber, StringFormat='Current v{0}'}" />
                    </Grid>
                  </Expander.Header>

                  <ItemsControl Margin="0,12,0,0"
                                ItemsSource="{Binding Versions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="contracts:FloorPlanLibraryVersionDto">
                        <Border Classes="section-card"
                                Padding="10"
                                Margin="0,0,0,8">
                          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       FontWeight="SemiBold"
                                       Text="{Binding DisplayName}" />
                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0">
                              <TextBlock Text="{Binding Status}" />
                              <TextBlock Classes="muted"
                                         FontSize="12"
                                         Text="{Binding CurationHistoryLabel}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Margin="12,0,0,0"
                                       Text="{Binding SourceUnit}" />
                            <TextBlock Grid.Column="3"
                                       Margin="12,0,0,0"
                                       FontWeight="SemiBold"
                                       Text="{Binding CurrentLabel}" />
                            <TextBlock Grid.Column="4"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding AutoFitReadinessLabel}" />
                            <Button Grid.Column="5"
                                    Margin="12,0,0,0"
                                    Content="Select"
                                    Click="SelectVersionButton_OnClick" />
                            <Button Grid.Column="6"
                                    Margin="12,0,0,0"
                                    Content="Edit"
                                    Click="OpenVersionButton_OnClick" />
                            <Button Grid.Column="7"
                                    Margin="12,0,0,0"
                                    Content="Adjust to Site Plan"
                                    IsEnabled="{Binding CanAdjustToSitePlan}"
                                    ToolTip.Tip="Requires an Auto-fit ready version. Setup required means the active published curation has no complete commissioned profile yet."
                                    ToolTip.ShowOnDisabled="True"
                                    Click="AdjustVersionToSitePlanButton_OnClick" />
                            <Button Grid.Column="8"
                                    Margin="12,0,0,0"
                                    Content="Delete"
                                    Click="DeleteVersionButton_OnClick" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Grid RowDefinitions="Auto,*"
          IsVisible="{Binding IsReviewScreenVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto"
            Margin="16,12,16,0"
            ColumnSpacing="12">
        <Button Content="← Library"
                Click="BackToLibraryButton_OnClick" />
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Classes="muted"
                   TextWrapping="Wrap"
                   Text="{Binding ActiveReviewViewModel.StatusMessage}" />
        <Button Grid.Column="2"
                Classes="accent"
                Content="Editar"
                IsEnabled="{Binding ActiveReviewViewModel.CanEditPublishedCuration}"
                Click="EditPublishedButton_OnClick" />
        <Button Grid.Column="3"
                Classes="primary"
                Content="Publish Curation"
                IsEnabled="{Binding ActiveReviewViewModel.CanPublishCuration}"
                Click="PublishButton_OnClick" />
      </Grid>
      <views:ReviewFloorPlanWindow Grid.Row="1"
                                   DataContext="{Binding ActiveReviewViewModel}" />
    </Grid>

    <Grid RowDefinitions="Auto,*"
          IsVisible="{Binding IsSitePlanAdjustmentScreenVisible}">
      <Grid ColumnDefinitions="Auto,*"
            Margin="16,12,16,0"
            ColumnSpacing="12">
        <Button Content="← Library"
                Click="BackToLibraryButton_OnClick" />
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Classes="muted"
                   Text="{Binding StatusMessage}" />
      </Grid>
      <views:SitePlanAdjustmentWindow Grid.Row="1"
                                      DataContext="{Binding ActiveSitePlanAdjustmentViewModel}" />
    </Grid>
  </Grid>
</Window>
