<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             x:Class="FloorplanFit.Desktop.App">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#D813171E" />
    <SolidColorBrush x:Key="PanelBrush" Color="#66343A46" />
    <SolidColorBrush x:Key="SectionBrush" Color="#4C3C4452" />
    <SolidColorBrush x:Key="BorderBrushMuted" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5FFFFFF" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#333B4654" />
    <SolidColorBrush x:Key="AccentBrushStrong" Color="#4D4A5566" />
    <SolidColorBrush x:Key="DangerBrush" Color="#40394550" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#33424D5D" />
  </Application.Resources>

  <Application.Styles>
    <themes:FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.panel-card">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BoxShadow" Value="0 16 40 0 #33000000" />
    </Style>

    <Style Selector="Border.section-card">
      <Setter Property="Background" Value="{DynamicResource SectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="BoxShadow" Value="0 10 24 0 #22000000" />
    </Style>

    <Style Selector="Border.metric-chip">
      <Setter Property="Background" Value="#3D36404C" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="#33374250" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrushStrong}" />
      <Setter Property="BorderBrush" Value="#80FFFFFF" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#33414C5A" />
      <Setter Property="BorderBrush" Value="#80FFFFFF" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.tool">
      <Setter Property="Background" Value="#33374250" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
    </Style>

    <Style Selector="Button.tool-active">
      <Setter Property="Background" Value="#5A4B5665" />
      <Setter Property="BorderBrush" Value="#B3FFFFFF" />
    </Style>

    <Style Selector="ToggleButton.folder-toggle">
      <Setter Property="Background" Value="{DynamicResource SectionBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ToggleButton.folder-toggle:checked">
      <Setter Property="Background" Value="#5A4A5566" />
      <Setter Property="BorderBrush" Value="#B3FFFFFF" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="#26313C48" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#26313C48" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushMuted}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

  </Application.Styles>
</Application>
